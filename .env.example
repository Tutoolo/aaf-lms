# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://fellowship:fellowship@localhost:5432/fellowship?schema=public"

# ─────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-to-a-32-char-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# Mux (recorded video)
# ─────────────────────────────────────────────
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# ─────────────────────────────────────────────
# 100ms (live classroom)
# ─────────────────────────────────────────────
HMS_ACCESS_KEY=""
HMS_SECRET=""
HMS_TEMPLATE_ID=""

# ─────────────────────────────────────────────
# Stripe (payments)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─────────────────────────────────────────────
# Resend (email)
# ─────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Fellowship <hello@fellowship.local>"

# ─────────────────────────────────────────────
# Judge0 (sandbox code execution)
# ─────────────────────────────────────────────
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""

# ─────────────────────────────────────────────
# Anthropic (sandbox AI assistant)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─────────────────────────────────────────────
# Algolia (search) — optional
# ─────────────────────────────────────────────
ALGOLIA_APP_ID=""
ALGOLIA_SEARCH_KEY=""
ALGOLIA_ADMIN_KEY=""

# ─────────────────────────────────────────────
# AWS S3 / Cloudflare R2 (file storage)
# ─────────────────────────────────────────────
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ─────────────────────────────────────────────
# Feature flags — when keys above are blank, integration stubs run in mock mode
# ─────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK_INTEGRATIONS="true"
